DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DB_SSL=true
PORT=3000

# The login works without any of the settings below: it falls back to the
# credentials built into server.js. Uncomment a line only to override it.
#
# Recommended in production, so the password in the repository stops working:
# AUTH_USERNAME=H&H_ADMIN
# AUTH_PASSWORD=
#
# Changing this signs out every active session:
# SESSION_SECRET=
#
# Aiven CA certificate; enables full TLS verification of the database:
# DB_CA_CERT=
